<h2>Product List</h2>

<h3>Add Product</h3>
<form method="POST" action="/admin/products">
  <label>Name:<input type="text" name="name" required /></label>
  <label>Description:<input type="text" name="description" required></label>
  <label>Price:<input type="number" name="price" step="0.01" required /></label>
  <label>Stock Quantity:<input type="number" name="stockQty" required /></label>
  <button type="submit">Add</button>
</form>

<h3>Existing Products</h3>
<table>
  <thead><tr><th>ID</th><th>Name</th><th>Description</th><th class="right">Price</th><th class="right">Stock</th><th>Edit</th></tr></thead>
  <tbody>
    {{#each products}}
      <tr>
        <td>{{id}}</td>
        <td>{{name}}</td>
        <td>{{description}}</td>
        <td class="right">${{price}}</td>
        <td class="right">{{stockQty}}</td>
        <td>
          <form method="POST" action="/admin/products/{{id}}/update" style="display:inline">
            <input name="name" value="{{name}}" />
            <input name="description" value="{{description}}" />
            <input name="price" value="{{price}}" style="width:80px" />
            <input name="stockQty" value="{{stockQty}}" style="width:60px" />
            <button type="submit">Update</button>
          </form>
          <form method="POST" action="/admin/products/{{id}}/delete" style="display:inline">
            <button type="submit">Delete</button>
          </form>
        </td>
      </tr>
    {{/each}}
  </tbody>
</table>